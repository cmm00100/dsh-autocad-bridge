{
  "name": "@local/autocad-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AutoCAD 2024 bridge: hosts the Python COM/MCP bridge process and exposes it as agent tools — lifecycle, settings, status and live logs.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "bridge/*.py",
    "bridge/.env",
    "bridge/requirements.txt"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
