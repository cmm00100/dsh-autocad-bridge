# ---------------------------------------------------------------------------
# DSH x AutoCAD 桥配置文件
# 插件面板里可调的参数，最终都写在这里（或由插件直接传环境变量覆盖）
# ---------------------------------------------------------------------------

# CAD 版本 → ProgID 对照
#   2024 → AutoCAD.Application.24
#   2023 → AutoCAD.Application.23
#   2022 → AutoCAD.Application.22
# 本机实测存在的：.24 / .24.1 / .24.2 / .24.3
CAD_PROG_ID=AutoCAD.Application.24

# 单条命令超时（毫秒）。CAD 画大图慢，建议 10000~15000
CAD_TIMEOUT=15000
# CAD 繁忙时重试次数与间隔（毫秒）
CAD_RETRY_TIMES=2
CAD_RETRY_DELAY=800

# MCP 传输方式：stdio（DSH 直接拉进程，推荐）/ http（单独调试用）
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8770

# 是否开启命令日志（写到 stderr，DSH 会收进日志面板）
CAD_LOG_COMMANDS=1
# 默认图层（不指定图层时使用；留空则用 CAD 当前图层）
CAD_DEFAULT_LAYER=
